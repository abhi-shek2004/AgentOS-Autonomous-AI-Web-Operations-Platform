# AgentOS Backend Environment Configuration
# Copy this file to `.env` and adjust values as needed.

PROJECT_NAME="AgentOS"
ENVIRONMENT=development

# Database — defaults to local SQLite so the app works out of the box.
# Set to PostgreSQL for production: postgresql://user:pass@host:5432/dbname
#
# Postgres via Docker (recommended for production):
#   docker run -d --name agentos-postgres \
#     -e POSTGRES_USER=agentos_user -e POSTGRES_PASSWORD=agentos_password \
#     -e POSTGRES_DB=agentos_db -p 5432:5432 postgres:15-alpine
# Then uncomment the DATABASE_URL below.
#
# DATABASE_URL=postgresql://agentos_user:agentos_password@localhost:5432/agentos_db

# Default: SQLite (zero-infra, works everywhere)
DATABASE_URL=sqlite:///./agentos.db

# Redis (optional, reserved for future caching)
# Redis via Docker:
#   docker run -d --name agentos-redis -p 6379:6379 redis:7-alpine
REDIS_URL=redis://localhost:6379/0

# Cryptographic Vault Key (Fernet uses a 32-byte derived key).
# CHANGE THIS IN PRODUCTION. Minimum 32 characters.
SECRET_VAULT_KEY=agentos-super-secret-vault-encryption-key-32bytes-2026

# JWT signing key
SECRET_KEY=agentos-jwt-signing-key-2026

# LLM API Keys — leave empty to use Simulation Mode.
OPENAI_API_KEY=
NVIDIA_API_KEY=

# Default model for planner/executor reasoning
DEFAULT_MODEL=gpt-4o
